# ---- Supabase (Dashboard > Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used by /api/account and /api/push/send. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- WebRTC (see README) ----
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
# TURN is needed for reliable calls across NATs/firewalls. Get these from your TURN provider
# (e.g. Cloudflare Calls TURN, Twilio, Metered, or your own coturn). These values reach the browser by design.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ---- Web Push ----
# Generate once:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string; must match the header you set on the Supabase Database Webhook.
PUSH_WEBHOOK_SECRET=

# ---- Tests only (use a SEPARATE test Supabase project) ----
# tests/rls reads NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY from .env.test.local
# tests/e2e reads E2E_BASE_URL (default http://localhost:3000)
